# ==============================================================================
# SOCIALCOUNT ANALYTICS - VARIABLES DE ENTORNO
# Copia este archivo a `.env` dentro de la carpeta `/server` y ajusta tus valores
# ==============================================================================

# Configuración del Servidor
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Base de Datos (PostgreSQL o SQLite para desarrollo local inmediato)
# Opción 1 - PostgreSQL (Producción / Recomendado):
# DATABASE_URL="postgresql://postgres:tu_password@localhost:5432/socialcount_db?schema=public"
# Opción 2 - SQLite (Desarrollo local sin instalar PostgreSQL):
DATABASE_URL="file:./dev.db"

# Seguridad y Criptografía
# Clave simétrica de 32 bytes (64 caracteres hexadecimales) para cifrar los Access Tokens de Meta con AES-256-GCM
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Secreto para firma y validación de tokens JWT
JWT_SECRET="super-secret-jwt-key-socialcount-change-in-production-123456789"
JWT_EXPIRES_IN="7d"

# Configuración Oficial de Meta for Developers
# Obtén estas credenciales en: https://developers.facebook.com/apps/
META_APP_ID="tu_meta_app_id"
META_APP_SECRET="tu_meta_app_secret"
META_API_VERSION="v21.0"
META_REDIRECT_URI="http://localhost:5000/api/oauth/meta/callback"

# Token de verificación para Webhooks de Meta (Graph API Webhooks)
META_WEBHOOK_VERIFY_TOKEN="socialcount_webhook_secret_verify_token_2026"

# Modo Demostración (Si es 'true', permite explorar el sistema con datos de muestra realistas)
# Se desactiva automáticamente o se puede alternar desde la UI
DEMO_MODE_DEFAULT=true
