// Prisma Schema para SocialCount Analytics
// Compatible con SQLite (desarrollo local) y PostgreSQL (producción)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  name         String
  passwordHash String
  avatarUrl    String?
  role         String          @default("ADMIN") // ADMIN, ANALYST, VIEWER
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  accounts     SocialAccount[]
  auditLogs    AuditLog[]

  @@map("users")
}

model SocialAccount {
  id                   String          @id @default(uuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform             String          // "FACEBOOK" | "INSTAGRAM"
  externalId           String          // ID de Meta (Page ID o IG Business ID)
  name                 String          // Nombre de la Página o Perfil
  username             String?         // @username en Instagram o slug
  profilePictureUrl    String?
  encryptedAccessToken String          // Token cifrado con AES-256-GCM
  tokenExpiresAt       DateTime?       // Fecha de vencimiento (null para páginas permanentes)
  tokenStatus          String          @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED, NEEDS_REAUTH
  permissions          String          @default("[]") // Permisos JSON aprobados
  isMonitored          Boolean         @default(true)
  lastSyncAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  posts                SocialPost[]
  comments             SocialComment[]
  syncJobs             SyncJob[]

  @@unique([platform, externalId])
  @@index([userId])
  @@index([platform])
  @@index([tokenStatus])
  @@map("social_accounts")
}

model SocialPost {
  id                   String          @id @default(uuid())
  socialAccountId      String
  socialAccount        SocialAccount   @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  platform             String          // "FACEBOOK" | "INSTAGRAM"
  externalId           String          // ID de Meta para el post
  permalink            String?         // URL externa al post
  message              String?         // Texto / Caption del post
  mediaType            String?         // IMAGE, VIDEO, CAROUSEL_ALBUM, STATUS
  mediaUrl             String?         // URL de miniatura o imagen
  publishedAt          DateTime        // Fecha de publicación en Meta
  apiCommentsCount     Int             @default(0) // Total reportado por la API de Meta
  repliesCount         Int             @default(0) // Total de respuestas recuperadas
  totalStoredComments  Int             @default(0) // Comentarios efectivamente guardados en la BD
  lastSyncAt           DateTime        @default(now())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  comments             SocialComment[]

  @@unique([platform, externalId])
  @@index([socialAccountId])
  @@index([platform])
  @@index([publishedAt])
  @@map("social_posts")
}

model SocialComment {
  id               String        @id @default(uuid())
  postId           String
  post             SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccountId  String
  socialAccount    SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  platform         String        // "FACEBOOK" | "INSTAGRAM"
  externalId       String        // ID único del comentario en Meta
  parentCommentId  String?       // ID externo del comentario padre si es una respuesta
  authorName       String?       // Nombre público del autor según permisos
  authorExternalId String?       // ID protegido del autor
  authorProfilePic String?
  text             String        // Contenido del comentario
  commentDate      DateTime      // Fecha original de creación en Meta
  isReply          Boolean       @default(false)
  replyCount       Int           @default(0)
  status           String        @default("VERIFIED") // VERIFIED, PENDING_SYNC, HIDDEN_BY_META, REMOVED
  capturedAt       DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([platform, externalId])
  @@index([postId])
  @@index([socialAccountId])
  @@index([platform])
  @@index([commentDate])
  @@index([parentCommentId])
  @@index([isReply])
  @@map("social_comments")
}

model SyncJob {
  id               String         @id @default(uuid())
  socialAccountId  String?
  socialAccount    SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  triggerSource    String         @default("MANUAL") // MANUAL, SCHEDULED, WEBHOOK
  status           String         @default("QUEUED") // QUEUED, IN_PROGRESS, COMPLETED, PARTIAL, FAILED
  startedAt        DateTime       @default(now())
  completedAt      DateTime?
  durationMs       Int?
  postsProcessed   Int            @default(0)
  commentsFetched  Int            @default(0)
  commentsAdded    Int            @default(0)
  commentsUpdated  Int            @default(0)
  errorSummary     String?
  createdAt        DateTime       @default(now())
  logs             SyncLog[]

  @@index([status])
  @@index([startedAt])
  @@map("sync_jobs")
}

model SyncLog {
  id        String   @id @default(uuid())
  syncJobId String
  syncJob   SyncJob  @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  level     String   // INFO, WARN, ERROR
  message   String
  metadata  String?  // JSON string
  timestamp DateTime @default(now())

  @@index([syncJobId])
  @@index([level])
  @@map("sync_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // ACCOUNT_CONNECTED, ACCOUNT_DISCONNECTED, SYNC_TRIGGERED, EXPORT_GENERATED, SETTINGS_UPDATED
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
